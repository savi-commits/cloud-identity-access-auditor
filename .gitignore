# -------------------------------------------------
#  .gitignore -- Cloud Identity and Access Auditor
#  Python + Flask project
# -------------------------------------------------

# -- Python ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# -- Virtual environments -------------------------
venv/
env/
ENV/
.venv/
.env/

# -- Environment / secrets ------------------------
# NEVER commit these
.env
.env.*
*.env
secrets.py
config_secrets.py
credentials.json
*.pem
*.key
*.p12

# -- Flask / runtime ------------------------------
instance/
.flask_session/
flask_session/

# -- Distribution / packaging ---------------------
dist/
build/
*.egg-info/
*.egg
MANIFEST

# -- Testing --------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# -- IDE / Editor ---------------------------------
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -- OS -------------------------------------------
Desktop.ini
$RECYCLE.BIN/

# -- Logs and temp --------------------------------
*.log
*.tmp
*.bak
